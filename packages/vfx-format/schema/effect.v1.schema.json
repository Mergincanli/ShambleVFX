{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mergincanli/ShambleVFX/schema/effect.v1.schema.json",
  "title": "Shamble VFX effect file, version 1",
  "description": "Times in ms, sizes in metres, colours as role names only (hexes live in the palette).",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "shamble-vfx"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "controls": {
      "type": "object",
      "properties": {
        "size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20
        },
        "colour": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)*$"
        }
      },
      "required": [
        "size",
        "intensity",
        "duration",
        "colour"
      ],
      "additionalProperties": false
    },
    "layers": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,47}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "type": {
                "type": "string",
                "const": "sprite"
              },
              "start": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "ms": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "ms"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "arrivalOf": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,47}$"
                      },
                      "ms": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "arrivalOf",
                      "ms"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "timing": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "const": "steps"
                      },
                      "perSecond": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 60
                      }
                    },
                    "required": [
                      "mode",
                      "perSecond"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "const": "smooth"
                      }
                    },
                    "required": [
                      "mode"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "at": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "input": {
                        "type": "string",
                        "enum": [
                          "origin",
                          "target"
                        ]
                      },
                      "offset": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "items": false,
                        "minItems": 3,
                        "maxItems": 3
                      }
                    },
                    "required": [
                      "input",
                      "offset"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "layer": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,47}$"
                      }
                    },
                    "required": [
                      "layer"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "image": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9 _.-]{0,63}\\.png$"
              },
              "flipbook": {
                "type": "object",
                "properties": {
                  "cols": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "rows": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "frames": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "loop": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "cols",
                  "rows",
                  "frames",
                  "loop"
                ],
                "additionalProperties": false
              },
              "pivot": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "sizeM": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 100
                  },
                  {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 100
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "tint": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "const": "keep"
                      }
                    },
                    "required": [
                      "mode"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "const": "multiply"
                      },
                      "role": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)*$"
                      }
                    },
                    "required": [
                      "mode",
                      "role"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "facing": {
                "type": "string",
                "enum": [
                  "camera",
                  "path"
                ]
              },
              "durationMs": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 600000
              }
            },
            "required": [
              "id",
              "name",
              "type",
              "start",
              "timing",
              "at",
              "image",
              "pivot",
              "sizeM",
              "tint",
              "facing"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,47}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "type": {
                "type": "string",
                "const": "projectile"
              },
              "start": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "ms": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "ms"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "arrivalOf": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,47}$"
                      },
                      "ms": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "arrivalOf",
                      "ms"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "timing": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "const": "steps"
                      },
                      "perSecond": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 60
                      }
                    },
                    "required": [
                      "mode",
                      "perSecond"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "const": "smooth"
                      }
                    },
                    "required": [
                      "mode"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "from": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "string",
                    "enum": [
                      "origin",
                      "target"
                    ]
                  },
                  "offset": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "items": false,
                    "minItems": 3,
                    "maxItems": 3
                  }
                },
                "required": [
                  "input",
                  "offset"
                ],
                "additionalProperties": false
              },
              "to": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "string",
                    "enum": [
                      "origin",
                      "target"
                    ]
                  },
                  "offset": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "items": false,
                    "minItems": 3,
                    "maxItems": 3
                  }
                },
                "required": [
                  "input",
                  "offset"
                ],
                "additionalProperties": false
              },
              "speedMps": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10000
              },
              "stretch": {
                "type": "number",
                "minimum": 0.05,
                "maximum": 100
              },
              "spinDegPerS": {
                "type": "number",
                "minimum": -36000,
                "maximum": 36000
              }
            },
            "required": [
              "id",
              "name",
              "type",
              "start",
              "timing",
              "from",
              "to",
              "speedMps",
              "stretch",
              "spinDegPerS"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "format",
    "version",
    "id",
    "name",
    "controls",
    "layers"
  ],
  "additionalProperties": false
}
