{
  "name": "shamble-vfx",
  "private": true,
  "description": "Shamble VFX: the effects editor for Shamble Frontlines, and the runtime that plays its effects.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "packages/vfx-format",
    "packages/vfx-runtime",
    "packages/vfx-editor",
    "packages/vfx-testpage"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@shamble/vfx-editor",
    "testpage": "npm run dev --workspace=@shamble/vfx-testpage",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc -p packages/vfx-format && tsc -p packages/vfx-runtime && tsc -p packages/vfx-editor && tsc -p packages/vfx-testpage",
    "images": "node tools/make-placeholder-images.mjs",
    "check:browser": "node tools/browser-check.mjs",
    "compare": "node tools/compare-board.mjs",
    "letters": "node tools/build-letters.mjs",
    "export": "node tools/export.mjs export",
    "check:export": "node tools/export.mjs check",
    "import": "node tools/export.mjs import"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
